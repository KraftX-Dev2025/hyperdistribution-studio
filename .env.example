# Optional. By default every user brings their own Claude API key (Settings page),
# and the server never stores it.
#
# To pay for everyone's usage on your own deployment instead, set both:
# ANTHROPIC_API_KEY=sk-ant-...
# HDS_SHARED_KEY=true
#
# Optional model override (default: claude-opus-5-5)
# HDS_MODEL=claude-opus-5-5
#
# Optional: link in the sidebar
# VITE_REPO_URL=https://github.com/you/hypermixer
#
# Optional: send AI and link-reading calls to another deployment (default: this site)
# VITE_API_BASE=https://your-site.vercel.app
